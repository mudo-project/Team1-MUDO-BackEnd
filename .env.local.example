# MySQL 컨테이너 초기화용 로컬 값이다. 운영 비밀번호를 사용하지 않는다.
LOCAL_MYSQL_ROOT_PASSWORD=changeme
# Spring Boot가 사용할 로컬 DB 계정이다.
DB_USERNAME=mudo_app
DB_PASSWORD=changeme

# 로컬 JWT 서명용 값이다. 팀원마다 32바이트 이상의 임의 문자열로 교체한다.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# 호스트 포트가 이미 사용 중이면 개인 .env.local에서만 변경한다.
# MySQL 컨테이너 내부 포트는 항상 3306이고, 앱 내부 포트는 항상 8080이다.
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8080
