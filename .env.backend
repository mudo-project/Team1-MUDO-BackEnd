# 팀 전체가 공통으로 사용하는 프론트 연동용 Docker 설정이다.
# 공개 가능한 로컬 전용 값만 사용하며 운영 비밀번호나 운영 JWT 시크릿을 넣지 않는다.
BACKEND_IMAGE=ganghyeon1031/mudo-groupware-backend:develop

LOCAL_MYSQL_ROOT_PASSWORD=local-root-password-2026
DB_USERNAME=mudo_app
DB_PASSWORD=local-db-password-2026
JWT_SECRET=local-development-only-change-this-secret-key

FRONTEND_ORIGINS=http://localhost:*,http://127.0.0.1:*
APP_HOST_PORT=8080
