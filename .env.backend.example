# Docker Hub에 공개된 최신 develop 백엔드 이미지다.
BACKEND_IMAGE=ganghyeon1031/mudo-groupware-backend:develop

# 각 팀원이 자기 PC에서만 사용하는 로컬 DB 값이다.
LOCAL_MYSQL_ROOT_PASSWORD=changeme
DB_USERNAME=mudo_app
DB_PASSWORD=changeme

# 각 팀원이 32바이트 이상의 임의 문자열로 변경한다.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# 프론트 개발 서버 주소와 백엔드 호스트 포트다.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
APP_HOST_PORT=8080
