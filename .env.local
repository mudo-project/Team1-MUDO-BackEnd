# 팀 전체가 공통으로 사용하는 로컬 Docker 개발 설정이다.
# 공개 가능한 로컬 전용 값만 사용하며 운영 비밀번호나 운영 JWT 시크릿을 넣지 않는다.
LOCAL_MYSQL_ROOT_PASSWORD=local-root-password-2026
DB_USERNAME=mudo
DB_PASSWORD=mudo
JWT_SECRET=local-development-only-change-this-secret-key
GOOGLE_TOKEN_ENCRYPTION_KEY=local-development-only-change-this-token-key

# 호스트에서 접근할 포트다. 컨테이너 내부 포트는 Compose 파일에 고정돼 있다.
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8081
